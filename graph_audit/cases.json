[
  {"name":"Python file-class-method containment","category":"structure","files":{"a.py":"class A:\n    def run(self):\n        return 1\n"},"check":"edges","kind":"contain","expected":[["a.py","a.py::A"],["a.py::A","a.py::A.run"]]},
  {"name":"Python nested function identity","category":"proposed capability","files":{"a.py":"def outer():\n    def inner():\n        return 1\n    return inner()\n"},"check":"symbols","expected":["a.py::outer","a.py::outer.inner"]},
  {"name":"Python conditional definition","category":"proposed capability","files":{"a.py":"if True:\n    def available():\n        return 1\n"},"check":"symbols","expected":["a.py::available"]},
  {"name":"Python flat-layout import","category":"resolution","files":{"pkg/a.py":"from pkg.b import helper\n","pkg/b.py":"def helper(): pass\n"},"check":"edges","kind":"import","expected":[["pkg/a.py","pkg/b.py"]]},
  {"name":"Python src-layout import","category":"resolution","files":{"src/pkg/a.py":"from pkg.b import helper\n","src/pkg/b.py":"def helper(): pass\n"},"check":"edges","kind":"import","expected":[["src/pkg/a.py","src/pkg/b.py"]]},
  {"name":"Python relative import","category":"resolution","files":{"src/pkg/a.py":"from .b import helper\n","src/pkg/b.py":"def helper(): pass\n"},"check":"edges","kind":"import","expected":[["src/pkg/a.py","src/pkg/b.py"]]},
  {"name":"Python two submodules in one import","category":"resolution","files":{"pkg/__init__.py":"","pkg/a.py":"x=1\n","pkg/b.py":"x=2\n","main.py":"from pkg import a, b\n"},"check":"edges","kind":"import","expected":[["main.py","pkg/a.py"],["main.py","pkg/b.py"]]},
  {"name":"Python alias retained in raw statement","category":"information loss","files":{"a.py":"from pkg import Base as Renamed\n"},"check":"imports","expected":[["a.py","pkg",["Base"],"from pkg import Base as Renamed"]]},
  {"name":"Local inheritance","category":"resolution","files":{"a.py":"class Base: pass\nclass Child(Base): pass\n"},"check":"edges","kind":"inherit","expected":[["a.py::Child","a.py::Base"]]},
  {"name":"External base must not bind unrelated local class","category":"false positive","files":{"a.py":"from thirdparty import Base\nclass Child(Base): pass\n","unrelated.py":"class Base: pass\n"},"check":"edges","kind":"inherit","expected":[]},
  {"name":"Imported aliased base resolves to its declaration","category":"resolution","files":{"a.py":"from base import Base as Renamed\nclass Child(Renamed): pass\n","base.py":"class Base: pass\n"},"check":"edges","kind":"inherit","expected":[["a.py::Child","base.py::Base"]]},
  {"name":"Cross-language same-name base must not bind","category":"false positive","files":{"a.py":"from thirdparty import Base\nclass Child(Base): pass\n","b.java":"class Base {}"},"check":"edges","kind":"inherit","expected":[]},
  {"name":"Python method caller is qualified","category":"scope","files":{"a.py":"class A:\n    def run(self):\n        helper()\n"},"check":"calls","expected":[["a.py","helper","A.run",3]]},
  {"name":"Nested call belongs only to nested function","category":"scope","files":{"a.py":"def outer():\n    def inner():\n        helper()\n    return inner\n"},"check":"calls","expected":[["a.py","helper","outer.inner",3]]},
  {"name":"Nested yield must not make outer a generator","category":"scope","files":{"a.py":"def outer():\n    def inner():\n        yield 1\n    return inner\n"},"check":"generator","expected":{"outer":false}},
  {"name":"Calls survive serialization","category":"information loss","files":{"a.py":"def f():\n    helper()\n"},"check":"calls_saved","expected":1},
  {"name":"Docstrings survive serialization","category":"information loss","files":{"a.py":"def f():\n    \"\"\"Return the answer.\"\"\"\n    return 42\n"},"check":"docstrings_saved","expected":["Return the answer."]},
  {"name":"Python exact body span available","category":"proposed capability","files":{"a.py":"def f(): return 42\n"},"check":"body_spans","expected":true},
  {"name":"Direct Python invocation edge","category":"proposed capability","files":{"a.py":"def helper(): pass\ndef f(): helper()\n"},"check":"edges","kind":"invoke","expected":[["a.py::f","a.py::helper"]]},
  {"name":"TypeScript relative file import","category":"resolution","files":{"src/a.ts":"import { helper } from './b';\n","src/b.ts":"export function helper() {}"},"check":"edges","kind":"import","expected":[["src/a.ts","src/b.ts"]]},
  {"name":"TypeScript function and method caller ownership","category":"scope","files":{"a.ts":"function outer() { helper(); }\nclass C { f() { helper(); } }\n"},"check":"calls","expected":[["a.ts","helper","C.f",2],["a.ts","helper","outer",1]]},
  {"name":"JavaScript CommonJS dependency","category":"proposed capability","files":{"a.js":"const b = require('./b');\n","b.js":"module.exports = {};\n"},"check":"edges","kind":"import","expected":[["a.js","b.js"]]},
  {"name":"TypeScript barrel re-export dependency","category":"proposed capability","files":{"a.ts":"export { helper } from './b';\n","b.ts":"export function helper() {}\n"},"check":"edges","kind":"import","expected":[["a.ts","b.ts"]]},
  {"name":"JavaScript same-file class inheritance","category":"resolution","files":{"a.js":"class Base {}\nclass Child extends Base {}\n"},"check":"edges","kind":"inherit","expected":[["a.js::Child","a.js::Base"]]},
