  {"name":"Rust module declaration dependency","category":"proposed capability","files":{"src/lib.rs":"pub mod models;","src/models.rs":"pub struct Item;"},"check":"edges","kind":"import","expected":[["src/lib.rs","src/models.rs"]]},
  {"name":"Rust trait implementation is not method inheritance","category":"relationship semantics","files":{"src/lib.rs":"trait Shape { fn area(&self); }\nstruct Circle;\nimpl Shape for Circle { fn area(&self) {} }"},"check":"edges","kind":"inherit","expected":[]},
  {"name":"Go receiver method same-file membership","category":"structure","files":{"a.go":"package p\ntype A struct {}\nfunc (a *A) Run() {}"},"check":"edges","kind":"contain","expected":[["a.go","a.go::A"],["a.go::A","a.go::A.Run"]]},
  {"name":"Go grouped type declarations retain every type","category":"structure","files":{"a.go":"package p\ntype (\n A struct{}\n B struct{}\n)\n"},"check":"symbols","expected":["a.go::A","a.go::B"]},
